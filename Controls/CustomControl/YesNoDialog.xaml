<Window x:Class="VirusScan2.Windows.CustomWindow.YesNoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VirusScan2.Control"
        mc:Ignorable="d"
        Title="{Binding Title}" 
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        MinWidth="250"
        MaxWidth="500"
        MinHeight="130"
        MaxHeight="600"
        AllowsTransparency="True"
        Background="Transparent"
        Opacity="0">

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <!-- Анимация прозрачности окна -->
                    <DoubleAnimation 
                        Storyboard.TargetProperty="Opacity"
                        From="0" To="1" 
                        Duration="0:0:0.3">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <!-- Основной Border со скруглением -->
    <Border CornerRadius="12" 
            Background="DarkBlue"
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <ScaleTransform ScaleX="0.9" ScaleY="0.9" />
        </Border.RenderTransform>
        <Border.Triggers>
            <EventTrigger RoutedEvent="Border.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <!-- Анимация увеличения -->
                        <DoubleAnimation 
                            Storyboard.TargetProperty="RenderTransform.ScaleX"
                            From="0.9" To="1" 
                            Duration="0:0:0.4">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation 
                            Storyboard.TargetProperty="RenderTransform.ScaleY"
                            From="0.9" To="1" 
                            Duration="0:0:0.4">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Border.Triggers>

        <!-- Тень для окна -->
        <Border.Effect>
            <DropShadowEffect Color="Black" 
                              BlurRadius="20" 
                              ShadowDepth="8" 
                              Opacity="0.4" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Верхняя шапка (скругление только сверху) -->
            <Border Grid.Row="0" 
                    Background="DarkBlue" 
                    Height="30"
                    CornerRadius="12,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Текст заголовка -->
                    <TextBlock Grid.Column="0" 
                               Text="{Binding Path=Title, RelativeSource={RelativeSource AncestorType=Window}}" 
                               VerticalAlignment="Center" 
                               Foreground="LightSkyBlue" 
                               Margin="10,0"
                               Opacity="0">
                        <TextBlock.RenderTransform>
                            <TranslateTransform X="-10" />
                        </TextBlock.RenderTransform>
                        <TextBlock.Triggers>
                            <EventTrigger RoutedEvent="TextBlock.Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation 
                                            Storyboard.TargetProperty="RenderTransform.X"
                                            From="-10" To="0" 
                                            Duration="0:0:0.3"
                                            BeginTime="0:0:0.1">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation 
                                            Storyboard.TargetProperty="Opacity"
                                            From="0" To="1" 
                                            Duration="0:0:0.2"
                                            BeginTime="0:0:0.1" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </TextBlock.Triggers>
                    </TextBlock>

                    <!-- Кнопка закрытия -->
                    <Button Grid.Column="1" 
                            Content="✕" 
                            Width="40" 
                            Background="Transparent" 
                            BorderThickness="0" 
                            Click="Close_Button_Click"  
                            Foreground="LightSkyBlue"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="btnBorder" Background="{TemplateBinding Background}">
                                    <ContentPresenter x:Name="btnText" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="btnBorder" Property="Background" Value="#E81123"/>
                                        <Setter TargetName="btnText" Property="TextBlock.Foreground" Value="White"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- Синяя область с сообщением -->
            <Grid Grid.Row="1" Background="MidnightBlue">
                <TextBlock Text="{Binding Message}" 
                           Foreground="LightSkyBlue" 
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center" 
                           TextWrapping="Wrap" 
                           Margin="15"
                           Opacity="0">
                    <TextBlock.RenderTransform>
                        <TranslateTransform X="-10" />
                    </TextBlock.RenderTransform>
                    <TextBlock.Triggers>
                        <EventTrigger RoutedEvent="TextBlock.Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation 
                                        Storyboard.TargetProperty="RenderTransform.X"
                                        From="-10" To="0" 
                                        Duration="0:0:0.3"
                                        BeginTime="0:0:0.15">
                                        <DoubleAnimation.EasingFunction>
                                            <CubicEase EasingMode="EaseOut" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation 
                                        Storyboard.TargetProperty="Opacity"
                                        From="0" To="1" 
                                        Duration="0:0:0.2"
                                        BeginTime="0:0:0.15" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </TextBlock.Triggers>
                </TextBlock>
            </Grid>

            <!-- Нижняя область с кнопками (скругление только снизу) -->
            <Border Grid.Row="2" 
                    Background="DarkBlue" 
                    Height="35"
                    CornerRadius="0,0,12,12">
                <Grid>
                    <!-- Кнопка "Нет" (слева) -->
                    <Button Content="Нет" 
                            Width="80" 
                            Background="Transparent" 
                            Foreground="LightSkyBlue"
                            BorderThickness="0.5" 
                            BorderBrush="LightSkyBlue" 
                            HorizontalAlignment="Left"
                            Click="NoButton_Click"
                            Margin="10,0,0,0"
                            Cursor="Hand"
                            RenderTransformOrigin="0.5,0.5">
                        <Button.RenderTransform>
                            <ScaleTransform ScaleX="0.85" ScaleY="0.85" />
                        </Button.RenderTransform>
                        <Button.Triggers>
                            <EventTrigger RoutedEvent="Button.Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation 
                                            Storyboard.TargetProperty="RenderTransform.ScaleX"
                                            From="0.85" To="1" 
                                            Duration="0:0:0.3"
                                            BeginTime="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation 
                                            Storyboard.TargetProperty="RenderTransform.ScaleY"
                                            From="0.85" To="1" 
                                            Duration="0:0:0.3"
                                            BeginTime="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Button.Triggers>
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Border"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="4">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="#1E3A5F" />
                                        <Setter TargetName="Border" Property="BorderBrush" Value="Aquamarine" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="#0A1E3D" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Кнопка "Да" (справа) -->
                    <Button Content="Да" 
                            Width="80" 
                            Background="Transparent" 
                            Foreground="LightSkyBlue"
                            BorderThickness="0.5" 
                            BorderBrush="LightSkyBlue" 
                            HorizontalAlignment="Right"
                            Click="YesButton_Click"
                            Margin="0,0,10,0"
                            Cursor="Hand"
                            RenderTransformOrigin="0.5,0.5">
                        <Button.RenderTransform>
                            <ScaleTransform ScaleX="0.85" ScaleY="0.85" />
                        </Button.RenderTransform>
                        <Button.Triggers>
                            <EventTrigger RoutedEvent="Button.Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation 
                                            Storyboard.TargetProperty="RenderTransform.ScaleX"
                                            From="0.85" To="1" 
                                            Duration="0:0:0.3"
                                            BeginTime="0:0:0.25">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation 
                                            Storyboard.TargetProperty="RenderTransform.ScaleY"
                                            From="0.85" To="1" 
                                            Duration="0:0:0.3"
                                            BeginTime="0:0:0.25">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Button.Triggers>
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Border"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="4">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="#1E3A5F" />
                                        <Setter TargetName="Border" Property="BorderBrush" Value="Aquamarine" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="#0A1E3D" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>