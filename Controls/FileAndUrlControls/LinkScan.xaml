<Window x:Class="VirusScan2.LinkScan"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VirusScan2"
        mc:Ignorable="d"
        Title="LinkScan" Height="450" Width="820"
        MinHeight="200" MinWidth="500"
        Icon="pack://application:,,,/URLScanIcon.ico">

    <Window.Resources>
        <!-- Все стили полностью сохранены из оригинального кода -->
        <Style TargetType="Button" x:Key="AnimatedButtonStyle">
            <Setter Property="Background" Value="MidnightBlue" />
            <Setter Property="Foreground" Value="LightSkyBlue" />
            <Setter Property="BorderBrush" Value="Aquamarine" />
            <Setter Property="BorderThickness" Value="0.6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform Y="-50" />
                </Setter.Value>
            </Setter>
            <Setter Property="Opacity" Value="0" />

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#1E3A5F" />
                                <Setter TargetName="Border" Property="BorderBrush" Value="Cyan" />
                                <Setter TargetName="Border" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#0A1E3D" />
                                <Setter TargetName="Border" Property="BorderBrush" Value="LightCyan" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="BackButtonStyle" BasedOn="{StaticResource AnimatedButtonStyle}">
            <Style.Triggers>
                <EventTrigger RoutedEvent="Button.Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation 
                                Storyboard.TargetProperty="RenderTransform.Y"
                                From="-50" To="0" 
                                Duration="0:0:0.5"
                                BeginTime="0:0:0">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation 
                                Storyboard.TargetProperty="Opacity"
                                From="0" To="1" 
                                Duration="0:0:0.3"
                                BeginTime="0:0:0" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button" x:Key="DelayedButtonStyle" BasedOn="{StaticResource AnimatedButtonStyle}">
            <Style.Triggers>
                <EventTrigger RoutedEvent="Button.Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation 
                                Storyboard.TargetProperty="RenderTransform.Y"
                                From="-50" To="0" 
                                Duration="0:0:0.5"
                                BeginTime="0:0:0.2">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation 
                                Storyboard.TargetProperty="Opacity"
                                From="0" To="1" 
                                Duration="0:0:0.3"
                                BeginTime="0:0:0.2" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button" x:Key="HiddenButtonStyle" BasedOn="{StaticResource AnimatedButtonStyle}">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform Y="-50" />
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="Visibility" Value="Visible">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation 
                                    Storyboard.TargetProperty="RenderTransform.Y"
                                    From="-50" To="0" 
                                    Duration="0:0:0.5">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation 
                                    Storyboard.TargetProperty="Opacity"
                                    From="0" To="1" 
                                    Duration="0:0:0.3" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation 
                                    Storyboard.TargetProperty="Opacity"
                                    From="1" To="0" 
                                    Duration="0:0:0.2" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBox" x:Key="TextBoxStyle">
            <Setter Property="Background" Value="MidnightBlue" />
            <Setter Property="Foreground" Value="LightSkyBlue" />
            <Setter Property="BorderBrush" Value="Aquamarine" />
            <Setter Property="BorderThickness" Value="0.7" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform Y="-30" />
                </Setter.Value>
            </Setter>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ScrollViewer x:Name="PART_ContentHost" 
                                          Margin="{TemplateBinding Padding}" />
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#7FFFD4" />
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="Aquamarine" />
                                <Setter TargetName="Border" Property="BorderThickness" Value="0.7" />
                                <Setter TargetName="Border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect 
                                            Color="Aquamarine" 
                                            BlurRadius="8" 
                                            ShadowDepth="0" 
                                            Opacity="0.6" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="False">
                                <Setter TargetName="Border" Property="Effect" Value="{x:Null}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <EventTrigger RoutedEvent="TextBox.Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation 
                                Storyboard.TargetProperty="RenderTransform.Y"
                                From="-30" To="0" 
                                Duration="0:0:0.5"
                                BeginTime="0:0:0.3">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation 
                                Storyboard.TargetProperty="Opacity"
                                From="0" To="1" 
                                Duration="0:0:0.3"
                                BeginTime="0:0:0.3" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Image">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="0.5" ScaleY="0.5" />
                </Setter.Value>
            </Setter>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />

            <Style.Triggers>
                <EventTrigger RoutedEvent="Image.Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation 
                                Storyboard.TargetProperty="RenderTransform.ScaleX"
                                From="0.5" To="1" 
                                Duration="0:0:0.6"
                                BeginTime="0:0:0.1">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation 
                                Storyboard.TargetProperty="RenderTransform.ScaleY"
                                From="0.5" To="1" 
                                Duration="0:0:0.6"
                                BeginTime="0:0:0.1">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation 
                                Storyboard.TargetProperty="Opacity"
                                From="0" To="1" 
                                Duration="0:0:0.4"
                                BeginTime="0:0:0.1" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="LightBlue" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform X="-20" />
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <EventTrigger RoutedEvent="TextBlock.Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation 
                                Storyboard.TargetProperty="RenderTransform.X"
                                From="-20" To="0" 
                                Duration="0:0:0.4"
                                BeginTime="0:0:0.4">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation 
                                Storyboard.TargetProperty="Opacity"
                                From="0" To="1" 
                                Duration="0:0:0.3"
                                BeginTime="0:0:0.4" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBlock" x:Key="HiddenTextBlockStyle" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform X="-20" />
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="Visibility" Value="Visible">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation 
                                    Storyboard.TargetProperty="RenderTransform.X"
                                    From="-20" To="0" 
                                    Duration="0:0:0.4">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation 
                                    Storyboard.TargetProperty="Opacity"
                                    From="0" To="1" 
                                    Duration="0:0:0.3" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation 
                                    Storyboard.TargetProperty="Opacity"
                                    From="1" To="0" 
                                    Duration="0:0:0.2" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Background" Value="MidnightBlue" />
            <Setter Property="Foreground" Value="LightSkyBlue" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="0" />
                </Setter.Value>
            </Setter>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />

            <Style.Triggers>
                <EventTrigger RoutedEvent="ProgressBar.Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation 
                                Storyboard.TargetProperty="RenderTransform.ScaleX"
                                From="0" To="1" 
                                Duration="0:0:0.5"
                                BeginTime="0:0:0.5">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation 
                                Storyboard.TargetProperty="Opacity"
                                From="0" To="1" 
                                Duration="0:0:0.3"
                                BeginTime="0:0:0.5" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ProgressBar" x:Key="HiddenProgressBarStyle" BasedOn="{StaticResource {x:Type ProgressBar}}">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="0" />
                </Setter.Value>
            </Setter>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />

            <Style.Triggers>
                <Trigger Property="Visibility" Value="Visible">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation 
                                    Storyboard.TargetProperty="RenderTransform.ScaleX"
                                    From="0" To="1" 
                                    Duration="0:0:0.5">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation 
                                    Storyboard.TargetProperty="Opacity"
                                    From="0" To="1" 
                                    Duration="0:0:0.3" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation 
                                    Storyboard.TargetProperty="Opacity"
                                    From="1" To="0" 
                                    Duration="0:0:0.2" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ScrollViewer" x:Key="HiddenScrollViewerStyle">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform X="30" />
                </Setter.Value>
            </Setter>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Border x:Name="ScrollViewerBorder"
                                Background="MidnightBlue"
                                BorderBrush="Aquamarine"
                                BorderThickness="0.7"
                                CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <ScrollContentPresenter Grid.Row="0" Grid.Column="0"
                                                        Margin="{TemplateBinding Padding}"
                                                        Content="{TemplateBinding Content}"
                                                        ContentTemplate="{TemplateBinding ContentTemplate}"
                                                        CanContentScroll="{TemplateBinding CanContentScroll}" />

                                <ScrollBar x:Name="PART_VerticalScrollBar"
                                           Grid.Row="0" Grid.Column="1"
                                           ViewportSize="{TemplateBinding ViewportHeight}"
                                           Maximum="{TemplateBinding ScrollableHeight}"
                                           Value="{Binding Path=VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                           Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                           Orientation="Vertical"
                                           Margin="0,4,4,4">
                                    <ScrollBar.Resources>
                                        <Style TargetType="ScrollBar">
                                            <Setter Property="Background" Value="MidnightBlue" />
                                            <Setter Property="Width" Value="8" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ScrollBar">
                                                        <Grid Background="{TemplateBinding Background}">
                                                            <Track x:Name="PART_Track"
                                                                   IsDirectionReversed="True">
                                                                <Track.Thumb>
                                                                    <Thumb Background="LightSkyBlue" 
                                                                           Width="15"
                                                                           Height="30">
                                                                        <Thumb.Template>
                                                                            <ControlTemplate TargetType="Thumb">
                                                                                <Border Background="{TemplateBinding Background}"
                                                                                        CornerRadius="3"
                                                                                        Margin="1,0,1,0" />
                                                                            </ControlTemplate>
                                                                        </Thumb.Template>
                                                                    </Thumb>
                                                                </Track.Thumb>
                                                            </Track>
                                                        </Grid>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ScrollBar.Resources>
                                </ScrollBar>

                                <ScrollBar x:Name="PART_HorizontalScrollBar"
                                           Grid.Row="1" Grid.Column="0"
                                           Orientation="Horizontal"
                                           ViewportSize="{TemplateBinding ViewportWidth}"
                                           Maximum="{TemplateBinding ScrollableWidth}"
                                           Value="{Binding Path=HorizontalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                           Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
                                           Margin="4,0,4,4">
                                    <ScrollBar.Resources>
                                        <Style TargetType="ScrollBar">
                                            <Setter Property="Background" Value="MidnightBlue" />
                                            <Setter Property="Height" Value="8" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ScrollBar">
                                                        <Grid Background="{TemplateBinding Background}">
                                                            <Track x:Name="PART_Track"
                                                                   IsDirectionReversed="False">
                                                                <Track.Thumb>
                                                                    <Thumb Background="LightSkyBlue" 
                                                                           Height="15"
                                                                           Width="30">
                                                                        <Thumb.Template>
                                                                            <ControlTemplate TargetType="Thumb">
                                                                                <Border Background="{TemplateBinding Background}"
                                                                                        CornerRadius="3"
                                                                                        Margin="0,1,0,1" />
                                                                            </ControlTemplate>
                                                                        </Thumb.Template>
                                                                    </Thumb>
                                                                </Track.Thumb>
                                                            </Track>
                                                        </Grid>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ScrollBar.Resources>
                                </ScrollBar>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="Visibility" Value="Visible">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation 
                                    Storyboard.TargetProperty="RenderTransform.X"
                                    From="30" To="0" 
                                    Duration="0:0:0.5">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation 
                                    Storyboard.TargetProperty="Opacity"
                                    From="0" To="1" 
                                    Duration="0:0:0.3" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation 
                                    Storyboard.TargetProperty="Opacity"
                                    From="1" To="0" 
                                    Duration="0:0:0.2" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="MidnightBlue" />
            <Setter Property="Foreground" Value="LightSkyBlue" />
            <Setter Property="BorderBrush" Value="Aquamarine" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform X="30" />
                </Setter.Value>
            </Setter>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer Focusable="False" 
                                          Background="{TemplateBinding Background}"
                                          Foreground="{TemplateBinding Foreground}">
                                <ItemsPresenter Margin="{TemplateBinding Padding}" />
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <EventTrigger RoutedEvent="ListBox.Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation 
                                Storyboard.TargetProperty="RenderTransform.X"
                                From="30" To="0" 
                                Duration="0:0:0.5"
                                BeginTime="0:0:0.3">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation 
                                Storyboard.TargetProperty="Opacity"
                                From="0" To="1" 
                                Duration="0:0:0.3"
                                BeginTime="0:0:0.3" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Кнопка "Назад" -->
        <Button Click="BackButton_Click" 
                Content="Вернуться назад" 
                Height="28" 
                Width="120"
                Background="MidnightBlue"
                Foreground="LightSkyBlue"
                BorderBrush="Aquamarine"
                BorderThickness="0.6"
                FontSize="13"
                VerticalAlignment="Top"
                HorizontalAlignment="Left"
                Margin="10,10,0,0"
                Grid.Row="0" Grid.Column="0"
                Style="{StaticResource BackButtonStyle}" />

        <!-- Основной контент - Viewbox растягивается на всё доступное пространство -->
        <Viewbox Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Stretch="Uniform" MaxHeight="465" MaxWidth="820">
            <Grid x:Name="ColumnGrid">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>

                <!-- Изображение -->
                <Image Source="pack://application:,,,/url-scan-image.png" 
                       Height="250" 
                       Margin="-20"
                       Style="{StaticResource {x:Type Image}}"/>

                <!-- TextBox -->
                <TextBox Grid.Row="1" 
                         x:Name="LinkTextBox"
                         Text="Вставьте ссылку для сканирования..."
                         Padding="5"
                         VerticalAlignment="Top" 
                         HorizontalAlignment="Center" 
                         Width="530" 
                         Height="45" 
                         FontSize="17"
                         Background="MidnightBlue"
                         Foreground="LightSkyBlue"
                         BorderBrush="Aquamarine"
                         BorderThickness="0.7"
                         GotFocus="LinkTextBox_GotFocus"
                         LostFocus="LinkTextBox_LostFocus"
                         Style="{StaticResource TextBoxStyle}"/>

                <!-- Кнопка "Сканировать" -->
                <Button Grid.Row="1" 
                        x:Name="ScanButton" 
                        Click="Button_Scan_Click" 
                        Content="Сканировать" 
                        Width="190" 
                        Height="40"
                        FontSize="20"
                        Foreground="LightSkyBlue" 
                        Background="MidnightBlue"  
                        BorderBrush="Aquamarine" 
                        BorderThickness="0.7" 
                        VerticalAlignment="Top"
                        Margin="65"
                        Style="{StaticResource DelayedButtonStyle}" />

                <!-- Кнопка "Посмотреть" (Collapsed по умолчанию) -->
                <Button Grid.Row="1" 
                        x:Name="ShowButton" 
                        Click="ShowButton_Click" 
                        Content="Посмотреть" 
                        Visibility="Collapsed"
                        Width="190" 
                        Height="40"
                        FontSize="20"
                        Foreground="LightSkyBlue" 
                        Background="MidnightBlue"  
                        BorderBrush="Aquamarine" 
                        BorderThickness="0.7" 
                        VerticalAlignment="Top"
                        Margin="65"
                        Style="{StaticResource HiddenButtonStyle}" />

                <!-- Кнопка "❌" для очистки -->
                <Button Grid.Row="1" 
                        Click="DeleteButton_Click" 
                        Content="❌"
                        Width="22" 
                        Height="25"
                        FontSize="15"
                        Foreground="LightSkyBlue" 
                        Background="MidnightBlue"  
                        BorderThickness="0" 
                        VerticalAlignment="Top"
                        Margin="485,9,0,49"
                        Style="{StaticResource DelayedButtonStyle}" />

                <!-- TextBlock для подсчёта обнаружений (Collapsed по умолчанию) -->
                <TextBlock x:Name="DetectionsCountTextBlock" 
                           Grid.Row="0"
                           FontSize="15" 
                           Foreground="LightBlue"
                           Visibility="Collapsed"
                           Margin="-30,60,0,0"
                           Style="{StaticResource HiddenTextBlockStyle}" />

                <!-- TextBlock с подсказкой (Collapsed по умолчанию) -->
                <TextBlock x:Name="ShowTextBlock" 
                           Grid.Row="1" 
                           FontSize="12" 
                           Foreground="LightBlue" 
                           Margin="0,70,380,0" 
                           Visibility="Collapsed"
                           Style="{StaticResource HiddenTextBlockStyle}">
                           Нажмите на кнопку справа 
                            <LineBreak/>
                           чтобы увидеть антивирусы 
                            <LineBreak/>
                           обнаружившие угрозу
                </TextBlock>

                <!-- ProgressBar для сканирования (Collapsed по умолчанию) -->
                <ProgressBar x:Name="LinkProgressBar" 
                             Grid.Row="2" 
                             IsIndeterminate="True" 
                             Background="MidnightBlue" 
                             Foreground="LightSkyBlue" 
                             Height="20" 
                             Width="530"
                             Margin="0,0,0,30" 
                             Visibility="Collapsed"
                             Style="{StaticResource HiddenProgressBarStyle}" />

                <!-- Кнопка "Посмотреть" для DeepSeek (Collapsed по умолчанию) -->
                <Button x:Name="ShowDSButton" 
                        Click="ShowDS_Click" 
                        Content="Посмотреть"
                        Height="35" 
                        Width="110" 
                        Margin="0,50,370,0"
                        Foreground="LightSkyBlue" 
                        Background="MidnightBlue"  
                        BorderBrush="Aquamarine" 
                        BorderThickness="0.7" 
                        Visibility="Collapsed"
                        Style="{StaticResource HiddenButtonStyle}" />

                <!-- ProgressBar для DeepSeek (Collapsed по умолчанию) -->
                <ProgressBar x:Name="DSProgressBar" 
                             IsIndeterminate="True" 
                             Background="MidnightBlue" 
                             Foreground="LightSkyBlue" 
                             Height="15" 
                             Width="110"
                             Margin="0,120,370,0" 
                             Visibility="Collapsed"
                             Style="{StaticResource HiddenProgressBarStyle}" />

                <!-- TextBlock для DeepSeek (Collapsed по умолчанию) -->
                <TextBlock x:Name="DSTextBlock"
                           FontSize="11" 
                           Foreground="LightBlue" 
                           Visibility="Collapsed"
                           Margin="-30,100,290,135"
                           Style="{StaticResource HiddenTextBlockStyle}">
                    Нажмите на кнопку под этим текстом
                    <LineBreak/>
                    чтобы посмотреть ответ на анализ от ИИ
                </TextBlock>
            </Grid>
        </Viewbox>

        <!-- ScrollViewer и ListBox (Collapsed по умолчанию) -->
        <ScrollViewer x:Name="LinkScroll"
                      Grid.Row="1" 
                      Grid.Column="1"
                      MaxHeight="400" 
                      MinWidth="150"
                      Width="Auto"
                      Margin="10,20,20,20"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Right"
                      VerticalScrollBarVisibility="Visible" 
                      HorizontalScrollBarVisibility="Disabled"
                      Visibility="Collapsed"
                      Style="{StaticResource HiddenScrollViewerStyle}">

            <ListBox x:Name="EnginesListBox" 
                     MinWidth="150"
                     MaxWidth="400"
                     Width="Auto"
                     Padding="10"
                     HorizontalAlignment="Stretch"
                     Foreground="LightSkyBlue" 
                     Background="MidnightBlue" 
                     BorderBrush="Aquamarine"
                     FontStretch="Expanded"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled" />
        </ScrollViewer>
    </Grid>

    <Window.Background>
        <ImageBrush ImageSource="pack://application:,,,/Background.jpg"/>
    </Window.Background>
</Window>